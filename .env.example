# ============================================
# Multi-Agent Telegram Crowd Simulator
# Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values
# Command: cp .env.example .env (Linux/macOS) or Copy-Item .env.example .env (PowerShell)

# --- DASHBOARD SETTINGS ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password
SECRET_KEY=change_me_to_a_random_long_string_for_session_security

# --- Telegram API Credentials ---
# Obtain your API ID & Hash from https://my.telegram.org (API Development Tools)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here

# --- Target Telegram Group ---
# The target group chat ID to simulate in (must be a negative number for groups/supergroups, e.g. -100xxxxxxxxxx)
TARGET_CHAT_ID=-1001234567890

# --- LLM API Keys ---
# Primary LLM: Google Gemini (Get key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback LLM: Groq (Optional, Get key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# --- Database Storage ---
DATABASE_URL=sqlite:///data/multibot.db

# --- System Server Ports ---
API_PORT=8100
STREAMLIT_PORT=8501
